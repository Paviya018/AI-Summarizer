# ============================================================
# AI Document Summarizer — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- AI Providers ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Gemini is tried first, then Ollama is used if Gemini fails.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# --- App Settings ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_random_secret_string

# --- Summarizer Behaviour ---
# Set to "true" to avoid AI API calls and use mock summaries.
# Set to "false" to enable configured providers and automatic failover.
USE_MOCK_SUMMARIZER=false

# --- File Upload Limits ---
# Maximum allowed upload size in megabytes
MAX_UPLOAD_SIZE_MB=20
