# ============================================================
# Git Ignore — AI Multilingual Document Summarizer
# ============================================================

# Environment variables & secrets (CRITICAL)
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Project generated runtime storage
backend/uploads/*
!backend/uploads/.gitkeep
backend/generated_audio/*
!backend/generated_audio/.gitkeep
backend/data/*
!backend/data/.gitkeep
*.png
temp_page_*.png
chunk_summaries.json

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
